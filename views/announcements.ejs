<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/messages') %>

<!-- Page Header Hero -->
<section class="py-5 bg-primary text-white position-relative" style="background: linear-gradient(135deg, #07193b 0%, #0b224d 100%);">
    <div class="container py-3 text-center">
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3 text-uppercase">
            <i class="fas fa-bullhorn me-1"></i> Official Bulletin
        </span>
        <h1 class="display-5 fw-bold mb-2">Notice Board & Announcements</h1>
        <p class="lead opacity-75 max-w-700 mx-auto">
            Stay updated with exam timetables, mock test schedules, holiday notices, and admission alerts.
        </p>
    </div>
</section>

<!-- Notices Listing -->
<section class="py-5 bg-light">
    <div class="container py-2">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <% if (typeof announcements !== 'undefined' && announcements && announcements.length > 0) { %>
                    <% announcements.forEach(function(notice) { %>
                        <div class="notice-card <%= notice.isImportant ? 'important' : '' %> p-4 mb-4">
                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-primary px-3 py-1.5"><%= notice.category %></span>
                                    <% if (notice.isImportant) { %>
                                        <span class="badge bg-warning text-dark fw-bold">
                                            <i class="fas fa-exclamation-circle me-1"></i> High Priority / Urgent
                                        </span>
                                    <% } %>
                                </div>
                                <small class="text-muted"><i class="far fa-calendar-alt me-1 text-primary"></i> <%= new Date(notice.createdAt).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %></small>
                            </div>

                            <h4 class="fw-bold text-dark mb-2"><%= notice.title %></h4>
                            <p class="text-secondary m-0 mb-3" style="line-height: 1.7;"><%= notice.content %></p>

                            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                <small class="text-muted">
                                    <i class="fas fa-users me-1 text-primary"></i> Target Audience: <strong class="text-dark"><%= notice.targetAudience %></strong>
                                </small>
                                <span class="badge bg-light text-primary border">
                                    <i class="fas fa-check-double me-1"></i> Official Notice
                                </span>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="text-center py-5 bg-white rounded-4 border p-5 shadow-sm">
                        <i class="fas fa-clipboard-list fa-3x text-muted mb-3"></i>
                        <h4 class="fw-bold text-primary">No Active Notices</h4>
                        <p class="text-muted mb-0">There are no announcements currently published. Please check back later.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>