<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/messages') %>

<section class="py-5 bg-light min-vh-100 d-flex align-items-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="bg-white p-4 p-md-5 rounded-4 shadow-sm border border-top border-4 border-primary">
                    <div class="text-center mb-4">
                        <div class="bg-primary text-white p-3 rounded-circle d-inline-block mb-3">
                            <i class="fas fa-user-shield fa-2x"></i>
                        </div>
                        <h3 class="fw-bold text-primary">Admin Portal</h3>
                        <p class="text-muted small">Sign in to manage Ansari Tutorial dashboard</p>
                    </div>

                    <form action="/admin/login" method="POST">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Admin Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fas fa-envelope text-primary"></i></span>
                                <input type="email" name="email" class="form-control" placeholder="admin@ansaritutorial.com" required>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Admin Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fas fa-key text-primary"></i></span>
                                <input type="password" name="password" class="form-control" placeholder="••••••••" required>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-blue w-100 py-2.5 fw-bold shadow mb-3">
                            <i class="fas fa-lock me-2"></i> Access Admin Console
                        </button>
                    </form>

                    <div class="bg-light p-3 rounded-3 text-center small text-muted">
                        <i class="fas fa-info-circle me-1 text-primary"></i> Default Admin Credentials:<br>
                        <strong>admin@ansaritutorial.com</strong> / <strong>admin123</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
