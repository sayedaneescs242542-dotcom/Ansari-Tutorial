<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/messages') %>

<section class="py-5 bg-light min-vh-100 d-flex align-items-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="bg-white p-4 p-md-5 rounded-4 shadow-sm border">
                    <div class="text-center mb-4">
                        <div class="bg-warning text-dark p-3 rounded-circle d-inline-block mb-3">
                            <i class="fas fa-user-graduate fa-2x"></i>
                        </div>
                        <h3 class="fw-bold text-primary">Student Portal Login</h3>
                        <p class="text-muted small">Access your course schedule, profile, and admission status</p>
                    </div>

                    <form action="/student/login" method="POST">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fas fa-envelope text-primary"></i></span>
                                <input type="email" name="email" class="form-control" placeholder="name@domain.com" required>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fas fa-lock text-primary"></i></span>
                                <input type="password" name="password" class="form-control" placeholder="••••••••" required>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-yellow w-100 py-2.5 fw-bold shadow mb-3">
                            <i class="fas fa-sign-in-alt me-2"></i> Log In to Dashboard
                        </button>
                    </form>

                    <div class="text-center pt-3 border-top">
                        <p class="small text-muted mb-0">Don't have a student account yet?</p>
                        <a href="/student/register" class="fw-bold text-primary">Create New Student Account</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
