<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/messages') %>

<section class="py-5 bg-light min-vh-100 d-flex align-items-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-7">
                <div class="bg-white p-4 p-md-5 rounded-4 shadow-sm border">
                    <div class="text-center mb-4">
                        <div class="bg-primary text-white p-3 rounded-circle d-inline-block mb-3">
                            <i class="fas fa-user-plus fa-2x"></i>
                        </div>
                        <h3 class="fw-bold text-primary">Student Registration</h3>
                        <p class="text-muted small">Register to track your admission details and course progress</p>
                    </div>

                    <form action="/student/register" method="POST">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                                <input type="text" name="name" class="form-control" placeholder="e.g. John Doe" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                                <input type="email" name="email" class="form-control" placeholder="name@domain.com" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Password <span class="text-danger">*</span></label>
                                <input type="password" name="password" class="form-control" placeholder="Min 6 characters" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Mobile Number <span class="text-danger">*</span></label>
                                <input type="tel" name="phone" class="form-control" placeholder="10-digit Phone" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Course Enrolled / Interested <span class="text-danger">*</span></label>
                                <select name="course" class="form-select" required>
                                    <% if (courses && courses.length > 0) { %>
                                        <% courses.forEach(function(c) { %>
                                            <option value="<%= c.title %>"><%= c.title %> (<%= c.category %>)</option>
                                        <% }); %>
                                    <% } else { %>
                                        <option value="Class 5th to 10th (SSC Board)">Class 5th to 10th (SSC Board)</option>
                                        <option value="11th & 12th Commerce">11th & 12th Commerce</option>
                                        <option value="11th & 12th Science (PCB/PCM)">11th & 12th Science (PCB/PCM)</option>
                                        <option value="CA Foundation Course">CA Foundation Course</option>
                                    <% } %>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Gender</label>
                                <select name="gender" class="form-select">
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Date of Birth</label>
                                <input type="date" name="dob" class="form-control">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Residential Address</label>
                                <input type="text" name="address" class="form-control" placeholder="City / Area">
                            </div>

                            <div class="col-12 mt-4">
                                <button type="submit" class="btn btn-blue w-100 py-2.5 fw-bold shadow">
                                    <i class="fas fa-check-circle me-2"></i> Register Account
                                </button>
                            </div>
                        </div>
                    </form>

                    <div class="text-center pt-3 mt-3 border-top">
                        <p class="small text-muted mb-0">Already registered?</p>
                        <a href="/student/login" class="fw-bold text-primary">Login to Student Account</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
