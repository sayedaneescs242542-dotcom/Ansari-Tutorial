<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/messages') %>

<section class="py-4 bg-light min-vh-100">
    <div class="container py-3">
        <div class="row g-4">
            <!-- Sidebar -->
            <div class="col-lg-3">
                <div class="admin-sidebar text-center mb-4">
                    <div class="bg-primary text-white p-3 rounded-circle d-inline-block mb-3" style="width: 70px; height: 70px; line-height: 40px;">
                        <i class="fas fa-user-shield fa-2x"></i>
                    </div>
                    <h5 class="fw-bold mb-1 text-primary"><%= admin.name %></h5>
                    <span class="badge bg-danger fw-bold mb-3"><%= admin.role %></span>

                    <ul class="sidebar-menu text-start">
                        <li><a href="/admin/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
                        <li><a href="/admin/admissions"><i class="fas fa-file-signature"></i> Admissions</a></li>
                        <li><a href="/admin/students"><i class="fas fa-user-graduate"></i> Manage Students</a></li>
                        <li><a href="/admin/courses"><i class="fas fa-book"></i> Manage Courses</a></li>
                        <li><a href="/admin/announcements" class="active"><i class="fas fa-bullhorn"></i> Announcements</a></li>
                        <li><a href="/admin/contacts"><i class="fas fa-envelope-open-text"></i> Contact Enquiries</a></li>
                        <li><a href="/admin/logout" class="text-danger"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                    </ul>
                </div>
            </div>

            <!-- Manage Announcements Content -->
            <div class="col-lg-9">
                <div class="custom-table-container p-4">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                        <div>
                            <h3 class="fw-bold text-primary mb-0">Notice Board Manager</h3>
                            <small class="text-muted">Total Notices: <%= announcements.length %></small>
                        </div>
                        
                        <div class="d-flex gap-2">
                            <input type="text" class="form-control table-search-input" data-table="noticesTable" placeholder="Search notices...">
                            <button class="btn btn-yellow fw-bold flex-shrink-0" data-bs-toggle="modal" data-bs-target="#addNoticeModal">
                                <i class="fas fa-bullhorn me-1"></i> Post Announcement
                            </button>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="noticesTable">
                            <thead>
                                <tr>
                                    <th>Announcement Title</th>
                                    <th>Category</th>
                                    <th>Priority</th>
                                    <th>Audience</th>
                                    <th>Date</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (announcements && announcements.length > 0) { %>
                                    <% announcements.forEach(function(anc) { %>
                                        <tr>
                                            <td>
                                                <strong class="text-dark"><%= anc.title %></strong>
                                                <small class="text-muted d-block text-truncate" style="max-width: 280px;"><%= anc.content %></small>
                                            </td>
                                            <td><span class="badge bg-primary"><%= anc.category %></span></td>
                                            <td>
                                                <% if (anc.isImportant) { %>
                                                    <span class="badge bg-warning text-dark"><i class="fas fa-exclamation-circle me-1"></i> Important</span>
                                                <% } else { %>
                                                    <span class="badge bg-light text-muted border">Normal</span>
                                                <% } %>
                                            </td>
                                            <td><small class="fw-bold text-secondary"><%= anc.targetAudience %></small></td>
                                            <td><small class="text-muted"><%= new Date(anc.createdAt).toLocaleDateString() %></small></td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-primary me-1" 
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#editNoticeModal"
                                                        data-id="<%= anc._id %>"
                                                        data-title="<%= anc.title %>"
                                                        data-category="<%= anc.category %>"
                                                        data-content="<%= anc.content %>"
                                                        data-audience="<%= anc.targetAudience %>"
                                                        data-important="<%= anc.isImportant %>">
                                                    <i class="fas fa-edit"></i> Edit
                                                </button>
                                                <form action="/admin/announcements/delete/<%= anc._id %>" method="POST" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger btn-delete-confirm">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">No announcements posted yet.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Add Notice Modal -->
<div class="modal fade" id="addNoticeModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="fas fa-bullhorn me-2"></i> Post New Announcement</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/announcements/add" method="POST">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Title *</label>
                            <input type="text" name="title" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Category *</label>
                            <select name="category" class="form-select" required>
                                <option value="Notice">Notice</option>
                                <option value="Exam">Exam</option>
                                <option value="Holiday">Holiday</option>
                                <option value="Admission">Admission</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Target Audience</label>
                            <input type="text" name="targetAudience" class="form-control" placeholder="All / 10th SSC / Commerce" value="All">
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="isImportant" id="isImportant">
                                <label class="form-check-label fw-bold text-danger" for="isImportant">
                                    Mark as Important / Urgent Banner
                                </label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Announcement Content *</label>
                            <textarea name="content" rows="4" class="form-control" required></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-yellow fw-bold">Publish Notice</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Notice Modal -->
<div class="modal fade" id="editNoticeModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="fas fa-edit me-2"></i> Edit Announcement</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/announcements/edit" method="POST">
                <input type="hidden" name="id" id="edit-notice-id">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Title</label>
                            <input type="text" name="title" id="edit-notice-title" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Category</label>
                            <select name="category" id="edit-notice-category" class="form-select" required>
                                <option value="Notice">Notice</option>
                                <option value="Exam">Exam</option>
                                <option value="Holiday">Holiday</option>
                                <option value="Admission">Admission</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Audience</label>
                            <input type="text" name="targetAudience" id="edit-notice-audience" class="form-control">
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="isImportant" id="edit-notice-important">
                                <label class="form-check-label fw-bold text-danger" for="edit-notice-important">
                                    Mark as Important / Urgent Banner
                                </label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Content</label>
                            <textarea name="content" id="edit-notice-content" rows="4" class="form-control" required></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-blue fw-bold">Update Notice</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
