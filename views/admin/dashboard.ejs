<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/messages') %>

<section class="py-4 bg-light min-vh-100">
    <div class="container py-3">
        <div class="row g-4">
            <!-- Admin Sidebar -->
            <div class="col-lg-3">
                <div class="admin-sidebar text-center mb-4">
                    <div class="bg-primary text-white p-3 rounded-circle d-inline-block mb-3" style="width: 70px; height: 70px; line-height: 40px;">
                        <i class="fas fa-user-shield fa-2x"></i>
                    </div>
                    <h5 class="fw-bold mb-1 text-primary"><%= admin.name %></h5>
                    <span class="badge bg-danger fw-bold mb-3"><%= admin.role %></span>

                    <ul class="sidebar-menu text-start">
                        <li><a href="/admin/dashboard" class="active"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
                        <li><a href="/admin/admissions"><i class="fas fa-file-signature"></i> Admissions</a></li>
                        <li><a href="/admin/students"><i class="fas fa-user-graduate"></i> Manage Students</a></li>
                        <li><a href="/admin/courses"><i class="fas fa-book"></i> Manage Courses</a></li>
                        <li><a href="/admin/announcements"><i class="fas fa-bullhorn"></i> Announcements</a></li>
                        <li><a href="/admin/contacts"><i class="fas fa-envelope-open-text"></i> Contact Enquiries</a></li>
                        <li><a href="/admin/logout" class="text-danger"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                    </ul>
                </div>
            </div>

            <!-- Dashboard Overview Content -->
            <div class="col-lg-9">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="fw-bold text-primary mb-0">Admin Control Center</h3>
                        <small class="text-muted">Ansari Tutorial Management Dashboard</small>
                    </div>
                    <a href="/seed" class="btn btn-outline-secondary btn-sm" onclick="return confirm('Ensure database is seeded with initial defaults?')"><i class="fas fa-database me-1"></i> System Active</a>
                </div>

                <!-- KPI Metric Cards Grid -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4 col-sm-6">
                        <div class="kpi-card border-start border-4 border-primary">
                            <div>
                                <div class="kpi-number"><%= stats.totalStudents %></div>
                                <div class="kpi-label">Total Students</div>
                            </div>
                            <div class="card-icon-box m-0">
                                <i class="fas fa-user-graduate"></i>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 col-sm-6">
                        <div class="kpi-card border-start border-4 border-warning">
                            <div>
                                <div class="kpi-number text-warning"><%= stats.pendingAdmissions %></div>
                                <div class="kpi-label">Pending Admissions</div>
                            </div>
                            <div class="card-icon-box yellow m-0">
                                <i class="fas fa-hourglass-half"></i>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 col-sm-6">
                        <div class="kpi-card border-start border-4 border-success">
                            <div>
                                <div class="kpi-number text-success"><%= stats.totalCourses %></div>
                                <div class="kpi-label">Active Courses</div>
                            </div>
                            <div class="card-icon-box m-0" style="background: rgba(34, 197, 94, 0.15); color: #15803D;">
                                <i class="fas fa-book-open"></i>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-sm-6">
                        <div class="kpi-card border-start border-4 border-info">
                            <div>
                                <div class="kpi-number text-info"><%= stats.totalAnnouncements %></div>
                                <div class="kpi-label">Announcements Posted</div>
                            </div>
                            <div class="card-icon-box m-0" style="background: rgba(14, 165, 233, 0.15); color: #0369A1;">
                                <i class="fas fa-bullhorn"></i>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-sm-12">
                        <div class="kpi-card border-start border-4 border-danger">
                            <div>
                                <div class="kpi-number text-danger"><%= stats.newContacts %></div>
                                <div class="kpi-label">New Contact Enquiries</div>
                            </div>
                            <div class="card-icon-box m-0" style="background: rgba(239, 68, 68, 0.15); color: #B91C1C;">
                                <i class="fas fa-envelope-open"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Admissions Table Preview -->
                <div class="custom-table-container p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-primary mb-0"><i class="fas fa-clock me-2 text-warning"></i> Recent Admission Applications</h5>
                        <a href="/admin/admissions" class="btn btn-sm btn-outline-primary fw-semibold">View All Applications</a>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Applicant Name</th>
                                    <th>Course</th>
                                    <th>Stream</th>
                                    <th>Marks %</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (recentAdmissions && recentAdmissions.length > 0) { %>
                                    <% recentAdmissions.forEach(function(adm) { %>
                                        <tr>
                                            <td>
                                                <strong class="text-dark"><%= adm.fullName %></strong><br>
                                                <small class="text-muted"><%= adm.phone %></small>
                                            </td>
                                            <td><%= adm.course %></td>
                                            <td><span class="badge bg-light text-dark border"><%= adm.stream %></span></td>
                                            <td><strong><%= adm.previousPercentage %>%</strong></td>
                                            <td>
                                                <% if (adm.status === 'Approved') { %>
                                                    <span class="badge status-approved">Approved</span>
                                                <% } else if (adm.status === 'Rejected') { %>
                                                    <span class="badge status-rejected">Rejected</span>
                                                <% } else { %>
                                                    <span class="badge status-pending">Pending</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <a href="/admin/admissions" class="btn btn-sm btn-light border">Manage</a>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">No admission applications received yet.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
