<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/messages') %>

<section class="py-4 bg-light min-vh-100">
    <div class="container py-3">
        <div class="row g-4">
            <!-- Sidebar -->
            <div class="col-lg-3">
                <div class="admin-sidebar text-center mb-4">
                    <div class="bg-primary text-white p-3 rounded-circle d-inline-block mb-3" style="width: 70px; height: 70px; line-height: 40px;">
                        <i class="fas fa-user-shield fa-2x"></i>
                    </div>
                    <h5 class="fw-bold mb-1 text-primary"><%= admin.name %></h5>
                    <span class="badge bg-danger fw-bold mb-3"><%= admin.role %></span>

                    <ul class="sidebar-menu text-start">
                        <li><a href="/admin/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
                        <li><a href="/admin/admissions"><i class="fas fa-file-signature"></i> Admissions</a></li>
                        <li><a href="/admin/students"><i class="fas fa-user-graduate"></i> Manage Students</a></li>
                        <li><a href="/admin/courses" class="active"><i class="fas fa-book"></i> Manage Courses</a></li>
                        <li><a href="/admin/announcements"><i class="fas fa-bullhorn"></i> Announcements</a></li>
                        <li><a href="/admin/contacts"><i class="fas fa-envelope-open-text"></i> Contact Enquiries</a></li>
                        <li><a href="/admin/logout" class="text-danger"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                    </ul>
                </div>
            </div>

            <!-- Manage Courses Content -->
            <div class="col-lg-9">
                <div class="custom-table-container p-4">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                        <div>
                            <h3 class="fw-bold text-primary mb-0">Course Catalog Manager</h3>
                            <small class="text-muted">Total Courses: <%= courses.length %></small>
                        </div>
                        
                        <div class="d-flex gap-2">
                            <input type="text" class="form-control table-search-input" data-table="coursesTable" placeholder="Search course title or category...">
                            <button class="btn btn-yellow fw-bold flex-shrink-0" data-bs-toggle="modal" data-bs-target="#addCourseModal">
                                <i class="fas fa-plus-circle me-1"></i> Add Course
                            </button>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="coursesTable">
                            <thead>
                                <tr>
                                    <th>Course Title</th>
                                    <th>Category</th>
                                    <th>Duration</th>
                                    <th>Fee Structure</th>
                                    <th>Badge</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (courses && courses.length > 0) { %>
                                    <% courses.forEach(function(crs) { %>
                                        <tr>
                                            <td>
                                                <strong class="text-primary"><%= crs.title %></strong>
                                                <small class="text-muted d-block text-truncate" style="max-width: 250px;"><%= crs.description %></small>
                                            </td>
                                            <td><span class="category-badge badge-<%= crs.category.toLowerCase() %>"><%= crs.category %></span></td>
                                            <td><small class="fw-semibold"><%= crs.duration %></small></td>
                                            <td><strong class="text-success"><%= crs.fee %></strong></td>
                                            <td><span class="badge bg-warning text-dark"><%= crs.highlightBadge %></span></td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-primary me-1" 
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#editCourseModal"
                                                        data-id="<%= crs._id %>"
                                                        data-title="<%= crs.title %>"
                                                        data-category="<%= crs.category %>"
                                                        data-description="<%= crs.description %>"
                                                        data-duration="<%= crs.duration %>"
                                                        data-fee="<%= crs.fee %>"
                                                        data-subjects="<%= crs.subjects ? crs.subjects.join(', ') : '' %>"
                                                        data-badge="<%= crs.highlightBadge %>">
                                                    <i class="fas fa-edit"></i> Edit
                                                </button>
                                                <form action="/admin/courses/delete/<%= crs._id %>" method="POST" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger btn-delete-confirm">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">No courses available.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Add Course Modal -->
<div class="modal fade" id="addCourseModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="fas fa-plus-circle me-2"></i> Add New Course</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/courses/add" method="POST">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Course Title *</label>
                            <input type="text" name="title" class="form-control" placeholder="e.g. Class 10th SSC Board" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Category *</label>
                            <select name="category" class="form-select" required>
                                <option value="School">School</option>
                                <option value="Commerce">Commerce</option>
                                <option value="Science">Science</option>
                                <option value="Arts">Arts</option>
                                <option value="Professional">Professional</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Duration *</label>
                            <input type="text" name="duration" class="form-control" placeholder="e.g. 1 Academic Year" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Fee Structure *</label>
                            <input type="text" name="fee" class="form-control" placeholder="e.g. ₹25,000 / Year" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Highlight Badge</label>
                            <input type="text" name="highlightBadge" class="form-control" placeholder="e.g. Top Choice">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Subjects (Comma separated)</label>
                            <input type="text" name="subjects" class="form-control" placeholder="Maths, Science, Accounts">
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Course Description *</label>
                            <textarea name="description" rows="3" class="form-control" required></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-yellow fw-bold">Save Course</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Course Modal -->
<div class="modal fade" id="editCourseModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="fas fa-edit me-2"></i> Edit Course</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/courses/edit" method="POST">
                <input type="hidden" name="id" id="edit-course-id">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Course Title</label>
                            <input type="text" name="title" id="edit-course-title" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Category</label>
                            <select name="category" id="edit-course-category" class="form-select" required>
                                <option value="School">School</option>
                                <option value="Commerce">Commerce</option>
                                <option value="Science">Science</option>
                                <option value="Arts">Arts</option>
                                <option value="Professional">Professional</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Duration</label>
                            <input type="text" name="duration" id="edit-course-duration" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Fee</label>
                            <input type="text" name="fee" id="edit-course-fee" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Badge</label>
                            <input type="text" name="highlightBadge" id="edit-course-badge" class="form-control">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Subjects (Comma separated)</label>
                            <input type="text" name="subjects" id="edit-course-subjects" class="form-control">
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Description</label>
                            <textarea name="description" id="edit-course-description" rows="3" class="form-control" required></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-blue fw-bold">Update Course</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
