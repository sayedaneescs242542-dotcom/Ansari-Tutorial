<!-- Latest Announcements Ticker -->
<% if (typeof latestAnnouncements !== 'undefined' && latestAnnouncements && latestAnnouncements.length > 0) { %>
    <section class="notice-ticker-bar">
        <div class="container">
            <div class="d-flex align-items-center gap-3 overflow-hidden">
                <span class="notice-ticker-pill">
                    <i class="fas fa-bell"></i> Center Notice
                </span>
                <marquee behavior="scroll" direction="left" scrollamount="6" class="fw-semibold m-0 text-dark">
                    <% latestAnnouncements.forEach(function(notice) { %>
                        <span class="me-5">
                            <i class="fas fa-circle text-danger me-1" style="font-size: 8px;"></i>
                            <strong><%= notice.title %>:</strong> <%= notice.content %>
                        </span>
                    <% }); %>
                </marquee>
                <a href="/announcements" class="btn btn-sm btn-dark text-warning fw-bold flex-shrink-0 d-none d-md-inline-block">View Notices</a>
            </div>
        </div>
    </section>
<% } %>

